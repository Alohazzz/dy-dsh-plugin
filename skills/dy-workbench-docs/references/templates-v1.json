{
  "version": 1,
  "documents": {
    "research": {
      "title": "调研报告",
      "format": "markdown",
      "requiredFields": ["projectId", "planId", "issueId", "documentVersion"],
      "sections": ["业务背景与范围", "业务规则与例外", "现状与证据", "历史结论核对", "影响范围", "需求逐项可行性", "待确认问题与结论"]
    },
    "proposal": {
      "title": "执行方案",
      "format": "markdown",
      "requiredFields": ["projectId", "planId", "issueId", "documentVersion", "researchVersion", "confirmedDecisions"],
      "sections": ["目标与范围", "实施依据与已确认决策", "修改范围与实施步骤", "验收与回归", "风险与异常处理"]
    },
    "execution": {
      "title": "执行小结",
      "format": "markdown",
      "requiredFields": ["projectId", "planId", "issueId", "documentVersion", "approvedProposalVersion"],
      "sections": ["执行依据", "实际修改", "与定稿的偏差", "验收结果", "待验证项"]
    },
    "change": {
      "title": "变更记录",
      "format": "json",
      "requiredFields": ["projectId", "planId", "issueId", "repository", "commitSha", "reason", "scope", "executionRef"]
    },
    "publication": {
      "title": "云效回写",
      "format": "json",
      "requiredFields": ["projectId", "planId", "issueId", "executionRef", "test", "receipts"],
      "optionalFields": ["score"],
      "testSections": ["影响范围与测试"],
      "legacyTestSections": ["影响范围与测试（测试向）"]
    },
    "completion": {
      "title": "计划完成报告",
      "format": "markdown",
      "requiredFields": ["projectId", "planId", "documentVersion", "reportStatus"],
      "sections": ["交付概况", "原定范围与变动", "逐议题交付与验证", "合并与审核结果", "遗留事项"]
    }
  }
}
