{
  "name": "dy-dsh-plugin",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=24", "dsh": ">=0.2.2-rc.3 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.27.0",
    "typescript": "~5.9.3"
  }
}
